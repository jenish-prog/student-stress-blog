{
  "name": "mindease",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -n api,web -c green,cyan \"npm run dev:server\" \"vite --host\"",
    "dev:server": "node server/index.js",
    "dev:vite": "vite --host",
    "dev:full": "concurrently -n api,web -c green,cyan \"npm run dev:server\" \"vite --host\"",
    "start": "node server/index.js",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "test": "node --test tests/api.test.js",
    "preview": "vite preview --host"

  },
  "dependencies": {
    "@types/canvas-confetti": "^1.9.0",
    "canvas-confetti": "^1.9.4",
    "cors": "^2.8.6",
    "dotenv": "^18.0.7",
    "express": "^5.3.0",
    "lucide-react": "^1.57.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "concurrently": "^10.0.6",
    "oxlint": "^1.81.0",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.2",
    "vite": "^8.3.0"
  }
}
